namespace gc_lifetime_demo;

define class Payload
  pub let String value = "owned";
end

fnc inspect(&Payload payload) => void {
  stdio.println(payload.value);
  return;
}

fnc consume(Payload payload) => void {
  stdio.println(payload.value);
  return;
}

pub routine main() => void {
  let Payload payload = new Payload();

  // The borrow is lexical and does not keep a second mutable owner.
  inspect(&payload);

  // Explicit GC is a bounded host-collector hint. It cannot invalidate
  // payload because ownership/liveness semantics remain authoritative.
  process.gc();
  stdio.println(payload.value);

  // Moving the value ends its usable lifetime in this scope.
  consume(payload);

  // A second collection request may be coalesced/rate-limited safely.
  process.gc();
  stdio.println("gc-lifetime-ok");
  return;
}
