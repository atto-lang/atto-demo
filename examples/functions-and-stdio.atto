// AttoLang browser-subset candidate: function call and stdio.
// A source file and host-only catalog tests cannot establish guest execution.
fnc add(int a, int b): int {
  return a + b;
}

pub fnc main(): int {
  val x: int = 40;
  stdio.println("Hello from WebAssembly!");
  stdio.println(add(x, 2));
  return add(x, 2);
}
