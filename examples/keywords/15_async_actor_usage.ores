namespace async_actor_usage_demo;

pub async fnc fetch() => int {
  return 42;
}

pub async fnc collect() => int {
  val result = await fetch();
  return result + 1;
}

pub actor fnc shared_worker(int value) => int {
  return value + 2;
}

pub isoactor fnc private_worker(int value) => int {
  return value + 1;
}

pub routine main() => void {
  val shared_result = shared_worker(40);
  val private_result = private_worker(40);
  stdio.println(shared_result);
  stdio.println(private_result);
  return;
}
