namespace four_way_params_demo;

define interface Named as
  fnc name() => String;
end

define trait Labelled is Named as
  pub val String label = "trait";

  pub name() => String {
    return self.label;
  }
end

define class RefUser with Labelled as
end

struct ValueUser {
  label: String;

  pub name() => String {
    return self.label;
  }
}

fnc through_class(RefUser value) => String {
  return value.name();
}

fnc through_struct(ValueUser value) => String {
  return value.name();
}

fnc through_interface(Named value) => String {
  return value.name();
}

fnc through_structural(@Structural Named value) => String {
  return value.name();
}

pub routine main() => void {
  val ref_user = new RefUser();
  let ValueUser value_user = ValueUser { label = "struct" };

  stdio.println(through_class(ref_user));
  stdio.println(through_struct(value_user));
  stdio.println(through_interface(ref_user));
  stdio.println(through_structural(value_user));
  return;
}
