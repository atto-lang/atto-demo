namespace option_demo;

fnc lookup(bool found) => Option<int> {
  if found; do
    return Some(42);
  else
    return None;
  fi
}

pub routine main() => void {
  val Option<int> present = lookup(true);
  val int value = present.unwrap();

  val Option<int> missing = lookup(false);
  val Result<int, OptionUnwrapError> safe = missing.unwrap_safe();

  stdio.println(value);
  stdio.println(safe.is_err());
  stdio.println(safe);
  stdio.println("option-unwrap-ok");
  return;
}
