namespace async_await_usage_demo;

pub async fnc fetch_count() => int {
  return 21;
}

pub async fnc doubled() => int {
  val int count = await fetch_count();
  return count * 2;
}

pub actor fnc worker(int value) => int {
  return value + 1;
}

pub async fnc await_actor_result() => int {
  val ActorHandle<int> handle = worker(41);
  return await handle.result();
}

fnc future_type_contract() => void {
  val Future<int> pending = fetch_count();
  return;
}

pub routine main() => void {
  stdio.println("async-await-usage-ok");
  return;
}
