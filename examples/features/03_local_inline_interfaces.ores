define module app as
  fnc make() => View<int> {
    interface View<T> {
      fnc get() => T;
    }

    struct Box is View<int> {
      value: int;

      pub get() => int {
        return self.value;
      }
    }

    return Box { value = 7 };
  }

  routine prove_nested_interface() => void {
    if true do
      interface NestedApi {
        fnc ping() => int;
      }
    fi
    return;
  }

  pub routine main() => void {
    val result = make();
    stdio.stdout.write(result.get());
    stdio.stdout.write(":");
    prove_nested_interface();
    stdio.stdout.write("local-interfaces-ok");
    return;
  }
end
