define module model as
  define interface Readable as
    fnc read() => int;
  end

  define trait Answering is Readable as
    private val int answer_value = 42;

    pub read() => int {
      return self.answer_value;
    }
  end

  define class Box with Answering as
    pub val int id;
  end

  struct Packet is Readable {
    value: int;

    pub read() => int {
      return self.value;
    }
  }
end

define module app as
  fnc through_interface(model.Readable value) => int {
    return value.read();
  }

  fnc through_class(model.Box value) => int {
    return value.read();
  }

  fnc through_struct(model.Packet value) => int {
    return value.read();
  }

  pub routine main() => void {
    stdio.stdout.write(through_interface(new model.Box(1)));
    stdio.stdout.write(":");
    stdio.stdout.write(through_interface(model.Packet { value = 7 }));
    stdio.stdout.write(":");
    stdio.stdout.write(through_class(new model.Box(2)));
    stdio.stdout.write(":");
    stdio.stdout.write(through_struct(model.Packet { value = 9 }));
    stdio.stdout.write(":type-roles-ok");
    return;
  }
end
