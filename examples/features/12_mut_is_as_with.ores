namespace mut_is_as_with_demo;

define interface Readable as
  fnc read() => int;
end

define trait Seeded as
  private val int seed = 40;

  pub seeded_value() => int {
    return self.seed + 2;
  }
end

define class Counter is Readable with Seeded as
  pub let int value = 0;

  pub read() => int {
    return self.seeded_value() + self.value;
  }
end

fnc bump(mut Counter counter) => void {
  counter.value = counter.value + 1;
  return;
}

pub routine main() => void {
  let Counter counter = new Counter();
  bump(counter);

  stdio.println(counter.read());
  stdio.println("mut-is-as-with-ok");
  return;
}
