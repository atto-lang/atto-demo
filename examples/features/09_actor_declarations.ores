namespace actor_usage_demo;

pub actor fnc private_worker(int value) => int {
  return value + 1;
}

pub shared actor fnc shared_worker(int value) => int {
  return value + 2;
}

shared actor Account {
  let int balance = 100;

  pub fnc withdraw(int amount) => void {
    self.balance = self.balance - amount;
    return;
  }

  pub fnc current() => int {
    return self.balance;
  }
}

fnc actor_type_contracts() => void {
  val ActorHandle<int> private_handle = private_worker(40);
  val ActorHandle<int> shared_handle = shared_worker(40);
  val Future<int> private_result = private_handle.result();
  val Future<int> shared_result = shared_handle.result();
  return;
}

pub routine main() => void {
  stdio.println("actor-declarations-ok");
  return;
}
